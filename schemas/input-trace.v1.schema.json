{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wl3pc.invalid/schemas/input-trace.v1.schema.json",
  "title": "WL3PC tick-indexed input trace, version 1",
  "description": "Each event sets the held buttons from its tick until the next event. Ticks are simulation ticks, not rendered frames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "ticks", "events"],
  "properties": {
    "format": {"const": "wl3pc.input-trace"},
    "format_version": {"const": 1},
    "description": {"type": "string"},
    "ticks": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "held"],
        "properties": {
          "tick": {"type": "integer", "minimum": 0},
          "held": {"type": "array", "uniqueItems": true, "items": {"enum": ["up", "down", "left", "right", "a", "b", "start", "select"]}}
        }
      }
    }
  }
}
