{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wl3pc.invalid/schemas/oracle-recording.v2.schema.json",
  "title": "Emulator oracle recording, version 2",
  "description": "Per-tick held buttons recorded in the oracle recorder, with a SHA-256 of all RAM every 60 ticks and at the end, so a replay can prove it stayed in sync. Lives under ignored local/recordings/. Version 2 moves the boot ROM and cartridge RAM into the start and adds save-state starts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "marker",
    "rom_sha256",
    "emulator",
    "start",
    "input",
    "checkpoints"
  ],
  "properties": {
    "format": {
      "const": "wl3pc.oracle-recording"
    },
    "format_version": {
      "const": 2
    },
    "marker": {
      "type": "string"
    },
    "rom_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "emulator": {
      "$ref": "#/$defs/emulator"
    },
    "start": {
      "$ref": "#/$defs/start"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "ram_sha256"
        ],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "ram_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "markers": {
      "description": "Optional labelled frames from the TAS editor; they do not affect replay.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "label"
        ],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "cgb",
        "sound_emulated"
      ],
      "properties": {
        "name": {
          "const": "PyBoy"
        },
        "version": {
          "type": "string"
        },
        "cgb": {
          "const": true
        },
        "sound_emulated": {
          "type": "boolean"
        }
      }
    },
    "boot_rom": {
      "description": "PyBoy's own CGB boot ROM, or the user's dump from the local store; named by SHA-256.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "enum": [
            "pyboy-bundled",
            "file"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cartridge_ram": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "empty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "sha256"
          ],
          "properties": {
            "source": {
              "const": "file"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "power_on": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "boot_rom",
        "cartridge_ram"
      ],
      "properties": {
        "kind": {
          "const": "power-on"
        },
        "boot_rom": {
          "$ref": "#/$defs/boot_rom"
        },
        "cartridge_ram": {
          "$ref": "#/$defs/cartridge_ram"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "route"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "state": {
      "description": "A PyBoy save state from the local store. `origin`, when known, rebuilds it: replay `input` from `start` and the memory digest must equal `ram_sha256`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256",
        "boot_rom",
        "origin"
      ],
      "properties": {
        "kind": {
          "const": "state"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "boot_rom": {
          "$ref": "#/$defs/boot_rom"
        },
        "origin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "frame",
                "movie",
                "ram_sha256",
                "input"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/start"
                },
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "movie": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ram_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "input": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "input-trace.v1.schema.json"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "start": {
      "oneOf": [
        {
          "$ref": "#/$defs/power_on"
        },
        {
          "$ref": "#/$defs/route"
        },
        {
          "$ref": "#/$defs/state"
        }
      ]
    },
    "input": {
      "$ref": "input-trace.v1.schema.json"
    }
  }
}
