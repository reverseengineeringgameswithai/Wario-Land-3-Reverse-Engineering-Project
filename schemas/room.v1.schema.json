{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wl3pc.invalid/schemas/room.v1.schema.json",
  "title": "WL3PC room, version 1",
  "description": "Tile grid in engine coordinates (x right, y down, origin top-left). Each character of `rows` is looked up in `legend`. Materials are runtime IDs, not original block handler pointers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "id", "tile_size_px", "legend", "rows"],
  "properties": {
    "format": {"const": "wl3pc.room"},
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "tile_size_px": {"const": 16},
    "legend": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 1},
      "additionalProperties": {"$ref": "#/$defs/material"}
    },
    "rows": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
  },
  "$defs": {
    "material": {"enum": ["empty", "solid", "platform"]}
  }
}
