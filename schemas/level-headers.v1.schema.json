{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wl3pc.invalid/schemas/level-headers.v1.schema.json",
  "title": "Extracted level headers, version 1",
  "description": "Output of tools/wl3pc/extract/level_headers.py. ROM-derived: lives only under ignored local/content/. Levels point at per-level room lists; list entries point at 8-byte room headers whose fields are named after the WRAM variables LoadRoom stores them in. A null list entry is a reset sentinel.",
  "type": "object",
  "required": ["format", "format_version", "marker", "exploratory", "provenance", "level_pointer_table", "level_count", "entries_per_list", "header_size", "levels", "lists", "headers", "audit"],
  "$defs": {
    "banked": {"type": "string", "pattern": "^[0-9a-f]{2,3}:[0-9a-f]{4}$"},
    "nibble": {"type": "integer", "minimum": 0, "maximum": 15},
    "byte": {"type": "integer", "minimum": 0, "maximum": 255}
  },
  "properties": {
    "format": {"const": "wl3pc.level-headers"},
    "format_version": {"const": 1},
    "marker": {"type": "string"},
    "exploratory": {"type": "boolean"},
    "level_pointer_table": {"$ref": "#/$defs/banked"},
    "level_count": {"type": "integer", "minimum": 1},
    "entries_per_list": {"type": "integer", "minimum": 1},
    "header_size": {"const": 8},
    "provenance": {
      "type": "object",
      "required": ["rom_sha256", "extractor", "extractor_version", "layout_evidence"],
      "properties": {"rom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "status"],
        "properties": {
          "level": {"type": "integer", "minimum": 0},
          "status": {"enum": ["decoded", "reset-sentinel"]},
          "pointer": {"type": "string", "pattern": "^[0-9a-f]{4}$"},
          "list": {"$ref": "#/$defs/banked"},
          "start_header": {"oneOf": [{"$ref": "#/$defs/banked"}, {"type": "null"}]},
          "start_room": {"oneOf": [{"$ref": "#/$defs/byte"}, {"type": "null"}]}
        },
        "if": {"properties": {"status": {"const": "decoded"}}},
        "then": {"required": ["list", "start_header", "start_room"]},
        "else": {"required": ["pointer"]}
      }
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "used_by_levels", "entries"],
        "properties": {
          "location": {"$ref": "#/$defs/banked"},
          "used_by_levels": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "entries": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/banked"}, {"type": "null"}]}},
          "symbol": {"type": ["string", "null"]}
        }
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "fields"],
        "properties": {
          "location": {"$ref": "#/$defs/banked"},
          "symbol": {"type": ["string", "null"]},
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spawn_y", "spawn_x", "upper_y_limit", "lower_y_limit", "left_x_limit", "right_x_limit",
                         "camera_config", "object_group", "animated_tiles_group", "pal_cycle", "room"],
            "properties": {
              "spawn_y": {"$ref": "#/$defs/nibble"},
              "spawn_x": {"$ref": "#/$defs/nibble"},
              "upper_y_limit": {"$ref": "#/$defs/nibble"},
              "lower_y_limit": {"$ref": "#/$defs/nibble"},
              "left_x_limit": {"$ref": "#/$defs/nibble"},
              "right_x_limit": {"$ref": "#/$defs/nibble"},
              "camera_config": {"$ref": "#/$defs/byte"},
              "object_group": {"$ref": "#/$defs/byte"},
              "animated_tiles_group": {"$ref": "#/$defs/byte"},
              "pal_cycle": {"$ref": "#/$defs/byte"},
              "room": {"$ref": "#/$defs/byte"}
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["levels_starting_on_reset_entry", "decoded_rooms_not_referenced"],
      "properties": {
        "levels_starting_on_reset_entry": {"type": "array", "items": {"type": "integer"}},
        "decoded_rooms_not_referenced": {"type": "array", "items": {"type": "integer"}},
        "lists_without_symbol": {"type": "array", "items": {"type": "string"}},
        "headers_without_symbol": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
