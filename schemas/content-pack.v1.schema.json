{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wl3pc.invalid/schemas/content-pack.v1.schema.json",
  "title": "WL3PC content pack manifest, version 1",
  "description": "Entry point of a content pack. Paths are relative to the manifest and must stay inside the pack directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "id", "title", "origin", "license", "movement", "rooms", "start"],
  "properties": {
    "format": {"const": "wl3pc.content-pack"},
    "format_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "origin": {"enum": ["synthetic", "original-extracted"]},
    "license": {"type": "string", "minLength": 1},
    "movement": {"$ref": "#/$defs/relpath"},
    "rooms": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/relpath"}},
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "x_px", "y_px"],
      "properties": {
        "room": {"$ref": "#/$defs/id"},
        "x_px": {"type": "integer", "minimum": 0},
        "y_px": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "relpath": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+\\.json$"}
  }
}
