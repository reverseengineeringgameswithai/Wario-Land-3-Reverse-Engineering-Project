; Engine configuration file.
; Pinned engine: see ../toolchain.lock.json (Godot 4.7.2-stable, standard build).

config_version=5

[application]

config/name="WL3PC"
config/description="Source-grounded native port workspace. Current scene: synthetic prototype, not Wario Land 3 gameplay."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="wl3pc"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=160
window/size/viewport_height=144
window/size/window_width_override=640
window/size/window_height_override=576
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
